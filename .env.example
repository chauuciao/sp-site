# ---- Firebase service account (server only — Project settings > Service accounts) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n for newlines (Vercel-style), the code un-escapes them
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ---- Firebase web app config (safe to expose — Project settings > Your apps > Web) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ---- The one person allowed to sign in and edit ----
OWNER_EMAIL=
